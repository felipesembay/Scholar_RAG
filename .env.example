# Copie para .env e preencha

# LLM — qualquer API compatível com OpenAI
#   OpenAI:     LLM_BASE_URL=            LLM_MODEL=gpt-4o-mini
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=deepseek/deepseek-v4.1-flash
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1      LLM_MODEL=qwen2.5:7b  LLM_API_KEY=ollama
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Modelo da tela Escrita do artigo (vazio = LLM_MODEL), ex.: anthropic/claude-sonnet-5.5
LLM_MODEL_WRITING=
# Modelo da análise completa do artigo (vazio = LLM_MODEL_WRITING), ex.: anthropic/claude-opus-5.5
LLM_MODEL_REVIEW=
ADMIN_PASSWORD=
ADMIN_SECRET_KEY=

# Elasticsearch
ES_URL=http://localhost:9200
ELASTIC_PASSWORD=
