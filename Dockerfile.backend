FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive

# Tesseract + idiomas + libs para PDF/imagem
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-por \
    poppler-utils \
    libgl1 \
    libglib2.0-0 \
    libsm6 libxext6 libxrender1 \
 && rm -rf /var/lib/apt/lists/*

# Tesseract 5 usa esse caminho
ENV TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata/

WORKDIR /app
COPY requirements.txt /app/requirements.txt
# Container has no GPU access: install the CPU build of the locked torch/torchvision
# (~5 GB smaller than the CUDA build) and skip the CUDA-only wheels from the lock.
RUN TORCH=$(grep -E '^torch==' /app/requirements.txt | cut -d= -f3 | cut -d' ' -f1) \
 && VISION=$(grep -E '^torchvision==' /app/requirements.txt | cut -d= -f3 | cut -d' ' -f1) \
 && pip install --no-cache-dir "torch==${TORCH}" "torchvision==${VISION}" \
      --index-url https://download.pytorch.org/whl/cpu \
 && grep -vE '^(torch|torchvision|triton|nvidia-[a-z0-9-]+)==' /app/requirements.txt > /tmp/requirements-cpu.txt \
 && pip install --no-cache-dir -r /tmp/requirements-cpu.txt \
 && python -c "import torch; assert not torch.version.cuda, torch.version.cuda"

COPY . /app

# Define PYTHONPATH para o código backend
ENV PYTHONPATH=/app/src

# Garanta que o FastAPI/uvicorn escuta em 0.0.0.0:8000
CMD ["uvicorn", "backend.api:app", "--host", "0.0.0.0", "--port", "8000"]